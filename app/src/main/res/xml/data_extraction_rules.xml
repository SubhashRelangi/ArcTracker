<?xml version="1.0" encoding="utf-8"?>
<!--
   ArcTracker Privacy-Preserving Data Extraction Rules (Android 12+ / API 31+)
   Excludes all unencrypted financial records and SQLite databases from cloud backup and D2D transfer.
   Users can create password-protected AES-256-GCM encrypted backups via Settings -> Backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all SQLite databases and sidecars from unencrypted Google Cloud backup -->
        <exclude domain="database" path="." />
        <exclude domain="database" path="arctracker_database" />
        <exclude domain="root" path="databases" />

        <!-- Exclude app files and external storage from cloud backup -->
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />

        <!-- Preserve non-sensitive app settings and preferences in cloud backup -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude all SQLite databases and sidecars from unencrypted device-to-device migration -->
        <!-- Financial data must be moved using password-protected AES-256-GCM encrypted backups -->
        <exclude domain="database" path="." />
        <exclude domain="database" path="arctracker_database" />
        <exclude domain="root" path="databases" />

        <!-- Exclude app files and external storage from device transfer -->
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />

        <!-- Allow non-sensitive app preferences to transfer to new device -->
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>