<?xml version="1.0" encoding="utf-8"?>
<!--
   ArcTracker Privacy-Preserving Backup Rules (API < 31)
   Excludes all unencrypted SQLite databases, sidecars, and internal database paths.
   Users can create password-protected AES-256-GCM encrypted backups via Settings -> Backup.
-->
<full-backup-content>
    <!-- Exclude all SQLite databases and sidecar files (WAL, SHM, journals) from unencrypted backup -->
    <exclude domain="database" path="." />
    <exclude domain="database" path="arctracker_database" />
    <exclude domain="root" path="databases" />

    <!-- Exclude app files and external storage to prevent unencrypted export or cache leakage -->
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />

    <!-- Preserve non-sensitive app settings and preferences -->
    <include domain="sharedpref" path="." />
</full-backup-content>